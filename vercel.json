{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "includeFiles": "{server,data}/**", "memory": 1024 }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "headers": [
    { "source": "/(js|css)/(.*)", "headers": [{ "key": "cache-control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/images/(.*)", "headers": [{ "key": "cache-control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] }
  ]
}
